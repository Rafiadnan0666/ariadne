{
  "name": "ariadne-browser",
  "version": "1.0.0",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run build:electron && electron .",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron .",
    "build:electron": "tsc --project tsconfig.main.json && tsc --project tsconfig.preload.json && node scripts/copy-assets.js",
    "build:renderer": "vite build",
    "build:preload": "tsc --project tsconfig.preload.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.tests.json && node --test dist-tests/tests/pipeline.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@types/react-dnd": "^2.0.36",
    "@types/react-dnd-html5-backend": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "electron-store": "^12.0.0",
    "keytar": "^7.9.0",
    "openai": "^7.62.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "sqlite3": "^5.1.6",
    "tiktoken": "^1.0.22",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.0.2"
  },
  "build": {
    "appId": "com.ariadne.browser",
    "productName": "Ariadne Browser",
    "directories": {
      "buildResources": "build",
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
